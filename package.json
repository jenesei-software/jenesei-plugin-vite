{
  "author": "Cyril Strone",
  "name": "@jenesei-software/jenesei-plugin-vite",
  "version": "3.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jenesei-software/jenesei-plugin-vite.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "build"
  ],
  "keywords": [
    "vite"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.es.js"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.cjs"
      }
    }
  },
  "scripts": {
    "check": "biome check src && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build",
    "build:main": "vite build",
    "bundle-visualizer": "npx vite-bundle-visualizer",
    "biome:lint": "biome lint src",
    "biome:format": "biome format --write src",
    "biome:migrate": "biome migrate --write",
    "biome:update": "biome update --write"
  },
  "dependencies": {
    "@jenesei-software/jenesei-library-log": "^2.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
